<!doctype html>
<html lang="{{ site.language }}" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="author" content="{{ site.author }}">
  <meta name="robots" content="{{ robots or 'index,follow' }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" type="application/atom+xml" title="{{ site.name }} RSS" href="{{ '/feed.xml' | url }}">
  <meta name="theme-color" content="#f8f8f6">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {% if ogImage or featuredImage or site.ogImage %}
  <meta property="og:image" content="{{ site.url }}{{ ogImage or featuredImage or site.ogImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ ogImageAlt or featuredImageAlt or site.ogImageAlt or title or site.name }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="{{ site.url }}{{ ogImage or featuredImage or site.ogImage }}">
  <meta name="twitter:image:alt" content="{{ ogImageAlt or featuredImageAlt or site.ogImageAlt or title or site.name }}">
  {% else %}
  <meta name="twitter:card" content="summary">
  {% endif %}
  <meta name="twitter:title" content="{{ title or site.title }}">
  <meta name="twitter:description" content="{{ description or site.description }}">
  <script>try{const t=localStorage.getItem("sek-theme");if(t==="dark"||t==="light")document.documentElement.dataset.theme=t}catch(e){}</script>
  <link rel="preload" href="{{ '/assets/fonts/inter-latin-wght-normal.woff2' | url }}" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ '/assets/css/site.css' | url }}">
  {% if pagefind %}<link rel="stylesheet" href="{{ '/pagefind/pagefind-component-ui.css' | url }}">{% endif %}
  <script type="application/ld+json">
  {
    "@context":"https://schema.org",
    "@type":"Organization",
    "name":{{ site.name | json | safe }},
    "url":{{ site.url | json | safe }}
  }
  </script>
  {% if schemaType == 'BlogPosting' %}
  <script type="application/ld+json">
  {
    "@context":"https://schema.org",
    "@type":"BlogPosting",
    "headline":{{ title | json | safe }},
    "description":{{ (description or site.description) | json | safe }},
    {% if ogImage or featuredImage or site.ogImage %}"image":{{ (site.url + (ogImage or featuredImage or site.ogImage)) | json | safe }},{% endif %}
    "datePublished":{{ (page.date | isoDate) | json | safe }},
    "dateModified":{{ ((updated or page.date) | isoDate) | json | safe }},
    "author":{"@type":"Person","name":{{ site.author | json | safe }}},
    "publisher":{"@type":"Organization","name":{{ site.name | json | safe }}},
    "mainEntityOfPage":{"@type":"WebPage","@id":{{ (site.url + page.url) | json | safe }}}
  }
  </script>
  {% elif schemaType == 'CreativeWork' %}
  <script type="application/ld+json">
  {
    "@context":"https://schema.org",
    "@type":"CreativeWork",
    "name":{{ title | json | safe }},
    "description":{{ (description or site.description) | json | safe }},
    "url":{{ (site.url + page.url) | json | safe }},
    "author":{"@type":"Person","name":{{ site.author | json | safe }}},
    "inLanguage":{{ site.language | json | safe }}
  }
  </script>
  {% else %}
  <script type="application/ld+json">
  {
    "@context":"https://schema.org",
    "@type":"WebSite",
    "name":{{ site.name | json | safe }},
    "url":{{ site.url | json | safe }},
    "description":{{ site.description | json | safe }},
    "inLanguage":{{ site.language | json | safe }}
  }
  </script>
  {% endif %}
  {% if schemaType == 'BlogPosting' or schemaType == 'CreativeWork' %}
  <script type="application/ld+json">
  {
    "@context":"https://schema.org",
    "@type":"BreadcrumbList",
    "itemListElement":[
      {"@type":"ListItem","position":1,"name":"Home","item":{{ site.url | json | safe }}},
      {"@type":"ListItem","position":2,"name":{{ breadcrumbSection | json | safe }},"item":{{ (site.url + breadcrumbUrl) | json | safe }}},
      {"@type":"ListItem","position":3,"name":{{ title | json | safe }},"item":{{ (site.url + page.url) | json | safe }}}
    ]
  }
  </script>
  {% endif %}
</head>
<body id="top">
  <a class="skip" href="#main">Skip to content</a>
  {% include "partials/header.njk" %}
  {{ content | safe }}
  {% include "partials/footer.njk" %}
  <script src="{{ '/assets/js/site.js' | url }}" defer></script>
  {% if pagefind %}<script src="{{ '/pagefind/pagefind-component-ui.js' | url }}" type="module"></script>{% endif %}
</body>
</html>