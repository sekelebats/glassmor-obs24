---
layout: layouts/base.njk
ogType: article
---
<main id="main" class="article-page">
  <article data-pagefind-body data-pagefind-filter="content_type:Journal">
    <div class="wrap article-top">
      <div class="eyebrow" data-pagefind-ignore>JOURNAL / {{ page.date | year }}<br>{% for tag in tags %}{% if tag != "post" %}{{ tag }}{% if not loop.last %} / {% endif %}{% endif %}{% endfor %}</div>
      <h1 data-pagefind-meta="title" data-pagefind-ignore>{{ title }}</h1>
      <p class="article-summary">{{ description }}</p>
      <div class="article-meta meta" data-pagefind-ignore>{{ page.date | readableDate }}<br>{{ content | readTime }} MIN READ<br>BY {{ site.author }}</div>
    </div>
    <div class="prose">{{ content | safe }}</div>
    <div class="wrap post-end" data-pagefind-ignore><a class="text-link" href="{{ '/journal/' | url }}">← BACK TO JOURNAL</a></div>
  </article>
</main>