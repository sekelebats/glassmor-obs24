---
layout: layouts/base.njk
ogType: article
schemaType: BlogPosting
breadcrumbSection: Journal
breadcrumbUrl: /journal/
---
<main id="main" class="article-page">
  <article data-pagefind-body data-pagefind-filter="content_type:Journal">
    <nav class="wrap breadcrumbs" aria-label="Breadcrumb" data-pagefind-ignore><a href="{{ '/' | url }}">Home</a><span aria-hidden="true">/</span><a href="{{ '/journal/' | url }}">Journal</a><span aria-hidden="true">/</span><span aria-current="page">{{ title }}</span></nav>
    <div class="wrap article-top">
      <div class="eyebrow" data-pagefind-ignore>JOURNAL / {{ page.date | year }}<br>{% for tag in tags %}{% if tag != "post" %}{{ tag }}{% if not loop.last %} / {% endif %}{% endif %}{% endfor %}</div>
      <h1 data-pagefind-meta="title" data-pagefind-ignore>{{ title }}</h1>
      <p class="article-summary">{{ description }}</p>
      <div class="article-meta meta" data-pagefind-ignore><time datetime="{{ page.date | dateISO }}">{{ page.date | readableDate }}</time><br>{{ content | readTime }} MIN READ<br>BY {{ site.author }}</div>
    </div>
    {% if featuredImage %}<figure class="wrap article-featured" data-pagefind-ignore><img src="{{ featuredImage | url }}" alt="{{ featuredImageAlt or title }}" {% if featuredImageWidth %}width="{{ featuredImageWidth }}"{% endif %}{% if featuredImageHeight %} height="{{ featuredImageHeight }}"{% endif %}{% if featuredImageSrcset %} srcset="{{ featuredImageSrcset }}" sizes="{{ featuredImageSizes or '(max-width: 760px) 100vw, 1200px' }}"{% endif %} loading="eager" fetchpriority="high" decoding="async"><figcaption>{{ featuredImageCaption or "" }}</figcaption></figure>{% endif %}
    <div class="prose">{{ content | safe }}</div>
    <div class="wrap post-end" data-pagefind-ignore><a class="text-link" href="{{ '/journal/' | url }}">{% icon "arrow-left" %} BACK TO JOURNAL</a><div class="share-tools"><button class="share-button" type="button" data-share data-share-title="{{ title }}" data-share-url="{{ site.url }}{{ page.url }}">{% icon "share-2" %} SHARE ARTICLE</button><span class="share-status" data-share-status role="status" aria-live="polite"></span></div></div>
  </article>
</main>