<footer>
  <div class="wrap footer-inner">
    <span>© {{ site.year }} {{ site.name }} — MADE WITH INTENTION.</span>
    <div class="footer-links">
      <a href="{{ '/journal/' | url }}">JOURNAL</a>
      <a href="{{ '/objects/' | url }}">OBJECTS</a>
      <a href="{{ '/search/' | url }}">SEARCH</a>
      <a href="{{ '/feed.xml' | url }}">RSS</a>
      <a href="#top">BACK TO TOP {% icon "arrow-up" %}</a>
    </div>
  </div>
  <div class="wrap footer-legal">
    {% for item in site.footerLinks %}<a href="{{ item.url | url }}">{{ item.label }}</a>{% endfor %}
  </div>
</footer>