{% if pagination.href.previous or pagination.href.next %}
<nav class="pagination" aria-label="Pagination">
  {% if pagination.href.previous %}<a href="{{ pagination.href.previous | url }}" rel="prev">{% icon "arrow-left" %} NEWER</a>{% else %}<span class="disabled">{% icon "arrow-left" %} NEWER</span>{% endif %}
  <span class="pagination-count">PAGE {{ pagination.pageNumber + 1 }} / {{ pagination.pages.length }}</span>
  {% if pagination.href.next %}<a href="{{ pagination.href.next | url }}" rel="next">OLDER {% icon "arrow-right" %}</a>{% else %}<span class="disabled">OLDER {% icon "arrow-right" %}</span>{% endif %}
</nav>
{% endif %}