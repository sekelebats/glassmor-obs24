<header class="masthead">
  <div class="wrap mast-inner">
    <a class="wordmark" href="{{ '/' | url }}">{{ site.name }}<span>® / {{ site.year }}</span></a>
    <nav class="nav" aria-label="Main navigation">
      {% for item in site.navigation %}<a href="{{ item.url | url }}"{% if page.url == item.url or breadcrumbSection == item.label %} aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor %}
    </nav>
    <div class="right-head">
      <a class="search-shortcut" href="{{ '/search/' | url }}" aria-label="Search">{% icon "search" %} SEARCH</a>
      <span class="availability"><i class="dot"></i> Independent / online</span>
      <button class="theme" id="theme" type="button" aria-label="Switch to dark mode" title="Switch theme">
        <span class="theme-icon theme-moon">{% icon "moon" %}</span>
        <span class="theme-icon theme-sun">{% icon "sun" %}</span>
      </button>
    </div>
  </div>
</header>