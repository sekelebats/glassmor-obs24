---
permalink: /feed.xml
eleventyExcludeFromCollections: true
eleventyTemplateEngine: njk
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }}</title><subtitle>{{ site.description }}</subtitle>
  <link href="{{ site.url }}/feed.xml" rel="self"/><link href="{{ site.url }}/"/>
  <updated>{% if collections.posts.length %}{{ collections.posts[0].date | dateToRfc3339 }}{% else %}{{ site.buildDate | dateToRfc3339 }}{% endif %}</updated><id>{{ site.url }}/</id>
  <author><name>{{ site.author }}</name></author>
  {% for post in collections.posts %}<entry><title>{{ post.data.title }}</title><link href="{{ site.url }}{{ post.url }}"/><id>{{ site.url }}{{ post.url }}</id><updated>{{ post.date | dateToRfc3339 }}</updated><summary>{{ post.data.description }}</summary></entry>{% endfor %}
</feed>